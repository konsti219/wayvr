diff --git a/src/chaperone_setup.rs b/src/chaperone_setup.rs
new file mode 100644
index 0000000..3ad070f
--- /dev/null
+++ b/src/chaperone_setup.rs
@@ -0,0 +1,115 @@
+use openvr as vr;
+
+#[derive(Default, macros::InterfaceImpl)]
+#[interface = "IVRChaperoneSetup"]
+#[versions(006)]
+pub struct ChaperoneSetup {
+    vtables: Vtables,
+}
+
+impl vr::IVRChaperoneSetup006_Interface for ChaperoneSetup {
+    fn CommitWorkingCopy(&self, _: vr::EChaperoneConfigFile) -> bool {
+        true
+    }
+
+    fn RevertWorkingCopy(&self) {}
+
+    fn GetWorkingPlayAreaSize(&self, size_x: *mut f32, size_z: *mut f32) -> bool {
+        unsafe {
+            if let Some(size_x) = size_x.as_mut() {
+                *size_x = 1.0;
+            }
+            if let Some(size_z) = size_z.as_mut() {
+                *size_z = 1.0;
+            }
+        }
+        true
+    }
+
+    fn GetWorkingPlayAreaRect(&self, rect: *mut vr::HmdQuad_t) -> bool {
+        unsafe {
+            if let Some(rect) = rect.as_mut() {
+                *rect = Default::default();
+            }
+        }
+        true
+    }
+
+    fn GetWorkingCollisionBoundsInfo(&self, _: *mut vr::HmdQuad_t, count: *mut u32) -> bool {
+        write_zero_count(count)
+    }
+
+    fn GetLiveCollisionBoundsInfo(&self, _: *mut vr::HmdQuad_t, count: *mut u32) -> bool {
+        write_zero_count(count)
+    }
+
+    fn GetWorkingSeatedZeroPoseToRawTrackingPose(&self, pose: *mut vr::HmdMatrix34_t) -> bool {
+        write_identity_pose(pose)
+    }
+
+    fn GetWorkingStandingZeroPoseToRawTrackingPose(&self, pose: *mut vr::HmdMatrix34_t) -> bool {
+        write_identity_pose(pose)
+    }
+
+    fn SetWorkingPlayAreaSize(&self, _: f32, _: f32) {}
+    fn SetWorkingCollisionBoundsInfo(&self, _: *mut vr::HmdQuad_t, _: u32) {}
+    fn SetWorkingPerimeter(&self, _: *mut vr::HmdVector2_t, _: u32) {}
+    fn SetWorkingSeatedZeroPoseToRawTrackingPose(&self, _: *const vr::HmdMatrix34_t) {}
+    fn SetWorkingStandingZeroPoseToRawTrackingPose(&self, _: *const vr::HmdMatrix34_t) {}
+    fn ReloadFromDisk(&self, _: vr::EChaperoneConfigFile) {}
+
+    fn GetLiveSeatedZeroPoseToRawTrackingPose(&self, pose: *mut vr::HmdMatrix34_t) -> bool {
+        write_identity_pose(pose)
+    }
+
+    fn ExportLiveToBuffer(&self, buffer: *mut std::ffi::c_char, length: *mut u32) -> bool {
+        const EMPTY_CHAPERONE: &[u8] = b"{}\0";
+        let Some(length) = (unsafe { length.as_mut() }) else {
+            return false;
+        };
+        if buffer.is_null() {
+            *length = EMPTY_CHAPERONE.len() as u32;
+            return true;
+        }
+        if (*length as usize) < EMPTY_CHAPERONE.len() {
+            *length = EMPTY_CHAPERONE.len() as u32;
+            return false;
+        }
+        unsafe {
+            std::ptr::copy_nonoverlapping(
+                EMPTY_CHAPERONE.as_ptr(),
+                buffer.cast(),
+                EMPTY_CHAPERONE.len(),
+            );
+        }
+        *length = EMPTY_CHAPERONE.len() as u32;
+        true
+    }
+
+    fn ImportFromBufferToWorking(&self, _: *const std::ffi::c_char, _: u32) -> bool {
+        true
+    }
+
+    fn ShowWorkingSetPreview(&self) {}
+    fn HideWorkingSetPreview(&self) {}
+    fn RoomSetupStarting(&self) {}
+}
+
+fn write_zero_count(count: *mut u32) -> bool {
+    let Some(count) = (unsafe { count.as_mut() }) else {
+        return false;
+    };
+    *count = 0;
+    true
+}
+
+fn write_identity_pose(pose: *mut vr::HmdMatrix34_t) -> bool {
+    let Some(pose) = (unsafe { pose.as_mut() }) else {
+        return false;
+    };
+    *pose = Default::default();
+    pose.m[0][0] = 1.0;
+    pose.m[1][1] = 1.0;
+    pose.m[2][2] = 1.0;
+    true
+}
