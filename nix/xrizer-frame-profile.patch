+fn custom_bindings_path(controller_type: &actions::ControllerType) -> PathBuf {
+    if let Ok(custom_dir) = std::env::var("XRIZER_CUSTOM_BINDINGS_DIR") {
+        PathBuf::from(custom_dir)
+    } else {
+        current_dir().unwrap().join("xrizer")
+    }
+    .join(format!("{controller_type:?}.json").to_lowercase())
+}
+
 impl<C: openxr_data::Compositor> Input<C> {
     fn load_bindings(
         &self,
@@ -255,18 +264,34 @@ impl<C: openxr_data::Compositor> Input<C> {
         bindings: Vec<actions::DefaultBindings>,
         context: &mut context::BindingsLoadContext,
     ) {
+        let mut bindings = bindings;
+        // Custom bindings can also add controllers the game ships no bindings for
+        for controller_type in [
+            actions::ControllerType::ViveController,
+            actions::ControllerType::ViveFocus3,
+            actions::ControllerType::Knuckles,
+            actions::ControllerType::OculusTouch,
+            actions::ControllerType::FrameController,
+        ] {
+            if !bindings
+                .iter()
+                .any(|b| b.controller_type == controller_type)
+                && custom_bindings_path(&controller_type).exists()
+            {
+                bindings.push(actions::DefaultBindings {
+                    binding_url: PathBuf::new(),
+                    controller_type,
+                });
+            }
+        }
+
         let mut it = bindings.into_iter().peekable();
         while let Some(actions::DefaultBindings {
             binding_url,
             controller_type,
         }) = it.next()
