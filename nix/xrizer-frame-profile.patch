diff --git a/src/input/profiles/frame.rs b/src/input/profiles/frame.rs
new file mode 100644
index 0000000..8b4f14d
--- /dev/null
+++ b/src/input/profiles/frame.rs
@@ -0,0 +1,230 @@
+use super::{
+    InteractionProfile, Left, MainAxisType, ProfileProperties, Property, Right,
+    SkeletalInputBindings, legal_paths, paths::*,
+};
+use crate::button_mask_from_ids;
+use crate::input::legacy::{self, LegacyBindings, button_mask_from_id};
+use crate::input::profiles::InputToXrPath;
+use crate::openxr_data::Hand;
+use glam::{EulerRot, Mat4, Quat, Vec3};
+
+pub const FRAME_CONTROLLER_EXTENSION_NAME: &str = "XR_VALVE_frame_controller_interaction";
+
+/// Steam Frame controller. Games without Frame bindings stay on Touch, which the runtime remaps.
+pub struct Frame;
+
+impl InteractionProfile for Frame {
+    type LegalPaths = legal_paths![
+        Both::<
+            (System, Click),
+            (System, Touch),
+            (Bumper, Click),
+            (Bumper, Touch),
+            (Squeeze, Click),
+            (Squeeze, Value),
+            (Squeeze, Touch),
+            (Trigger, Click),
+            (Trigger, Value),
+            (Trigger, Touch),
+            (Thumbstick, ()),
+            (Thumbstick, Click),
+            (Thumbstick, Touch),
+        >,
+        Left::<
+            (DpadUp, Click),
+            (DpadUp, Touch),
+            (DpadDown, Click),
+            (DpadDown, Touch),
+            (DpadLeft, Click),
+            (DpadLeft, Touch),
+            (DpadRight, Click),
+            (DpadRight, Touch),
+            (View, Click),
+            (View, Touch),
+        >,
+        Right::<
+            (A, Click),
+            (A, Touch),
+            (B, Click),
+            (B, Touch),
+            (X, Click),
+            (X, Touch),
+            (Y, Click),
+            (Y, Touch),
+            (Menu, Click),
+            (Menu, Touch),
+        >
+    ];
+    fn properties() -> &'static ProfileProperties {
+        use openvr::EVRButtonId::*;
+        static DEVICE_PROPERTIES: ProfileProperties = ProfileProperties {
+            model: Property::PerHand {
+                left: c"Frame Controller (Left)",
+                right: c"Frame Controller (Right)",
+            },
+            openvr_controller_type: c"frame_controller",
+            // No Frame model is bundled, Quest 2 is the closest stand-in
+            render_model_name: Property::PerHand {
+                left: c"oculus_quest2_controller_left",
+                right: c"oculus_quest2_controller_right",
+            },
+            registered_device_type: Property::PerHand {
+                left: c"frame_controller/FRAME-CONTROLLER-LEFT",
+                right: c"frame_controller/FRAME-CONTROLLER-RIGHT",
+            },
+            serial_number: Property::PerHand {
+                left: c"FRAME-CONTROLLER-LEFT",
+                right: c"FRAME-CONTROLLER-RIGHT",
+            },
+            tracking_system_name: c"frame_controller",
+            manufacturer_name: c"Valve",
+            main_axis: MainAxisType::Thumbstick,
+            legacy_buttons_mask: button_mask_from_ids!(
+                System,
+                ApplicationMenu,
+                Grip,
+                A,
+                Axis0,
+                Axis1,
+                Axis2
+            ),
+        };
+        &DEVICE_PROPERTIES
+    }
+    fn profile_path() -> &'static str {
+        "/interaction_profiles/valve/frame_controller_valve"
+    }
+    fn has_required_extensions(enabled_extensions: &openxr::ExtensionSet) -> bool {
+        enabled_extensions
+            .other
+            .iter()
+            .any(|ext| ext.strip_suffix(b"\0") == Some(FRAME_CONTROLLER_EXTENSION_NAME.as_bytes()))
+    }
+
+    fn legacy_bindings(c: &InputToXrPath<Self>) -> LegacyBindings {
+        LegacyBindings {
+            extra: legacy::Bindings {
+                grip_pose: c.pose(),
+            },
+            trigger: c.leftright::<Trigger, Value, _, _>(),
+            trigger_click: c.leftright::<Trigger, Value, _, _>(),
+            app_menu: [
+                c.into::<Left<DpadLeft, Click>, _>(),
+                c.into::<Right<B, Click>, _>(),
+            ]
+            .concat(),
+            a: [
+                c.into::<Left<DpadDown, Click>, _>(),
+                c.into::<Right<A, Click>, _>(),
+            ]
+            .concat(),
+            squeeze_click: c.leftright::<Squeeze, Value, _, _>(),
+            squeeze: c.leftright::<Squeeze, Value, _, _>(),
+            main_xy: c.leftright::<Thumbstick, (), _, _>(),
+            main_xy_click: c.leftright::<Thumbstick, Click, _, _>(),
+            main_xy_touch: c.leftright::<Thumbstick, Touch, _, _>(),
+            haptic: c.haptics(),
+        }
+    }
+
+    fn skeletal_input_bindings(c: &InputToXrPath<Self>) -> SkeletalInputBindings {
+        SkeletalInputBindings {
+            thumb_touch: [
+                c.leftright::<Thumbstick, Touch, _, _>(),
+                c.into::<Left<DpadUp, Touch>, _>(),
+                c.into::<Left<DpadDown, Touch>, _>(),
+                c.into::<Left<DpadLeft, Touch>, _>(),
+                c.into::<Left<DpadRight, Touch>, _>(),
+                c.into::<Right<A, Touch>, _>(),
+                c.into::<Right<B, Touch>, _>(),
+                c.into::<Right<X, Touch>, _>(),
+                c.into::<Right<Y, Touch>, _>(),
+            ]
+            .concat(),
+            index_touch: c.leftright::<Trigger, Touch, _, _>(),
+            index_curl: c.leftright::<Trigger, Value, _, _>(),
+            rest_curl: c.leftright::<Squeeze, Value, _, _>(),
+        }
+    }
+
+    // openxr_grip from SteamVR's frame_controller render models
+    fn offset_grip_pose(hand: Hand) -> Mat4 {
+        let x = match hand {
+            Hand::Left => -0.003117,
+            Hand::Right => 0.003117,
+        };
+        Mat4::from_rotation_translation(
+            Quat::from_euler(EulerRot::XYZ, 2.8091_f32.to_radians(), 0.0, 0.0),
+            Vec3::new(x, -0.004277, 0.099501),
+        )
+        .inverse()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::{Frame, InteractionProfile};
+    use crate::input::tests::Fixture;
+    use openxr as xr;
+
+    #[test]
+    fn verify_bindings() {
+        let f = Fixture::new();
+        f.load_actions(c"actions.json");
+
+        let path = Frame::profile_path();
+        f.verify_bindings::<bool>(
+            path,
+            c"/actions/set1/in/boolact",
+            [
+                "/user/hand/left/input/dpad_down/click".into(),
+                "/user/hand/left/input/dpad_left/click".into(),
+                "/user/hand/left/input/view/click".into(),
+                "/user/hand/left/input/system/click".into(),
+                "/user/hand/left/input/bumper/click".into(),
+                "/user/hand/right/input/a/click".into(),
+                "/user/hand/right/input/x/click".into(),
+                "/user/hand/right/input/menu/click".into(),
+                "/user/hand/left/input/trigger/click".into(),
+                "/user/hand/right/input/thumbstick/click".into(),
+                "/user/hand/right/input/thumbstick/touch".into(),
+            ],
+        );
+
+        f.verify_bindings::<f32>(
+            path,
+            c"/actions/set1/boolact_asfloat",
+            [
+                "/user/hand/left/input/squeeze/value".into(),
+                "/user/hand/right/input/squeeze/value".into(),
+            ],
+        );
+
+        f.verify_bindings::<f32>(
+            path,
+            c"/actions/set1/in/vec1act",
+            [
+                "/user/hand/left/input/trigger/value".into(),
+                "/user/hand/right/input/trigger/value".into(),
+            ],
+        );
+
+        f.verify_bindings::<xr::Vector2f>(
+            path,
+            c"/actions/set1/in/vec2act",
+            [
+                "/user/hand/left/input/thumbstick".into(),
+                "/user/hand/right/input/thumbstick".into(),
+            ],
+        );
+
+        f.verify_bindings::<xr::Haptic>(
+            path,
+            c"/actions/set1/in/vib",
+            [
+                "/user/hand/left/output/haptic".into(),
+                "/user/hand/right/output/haptic".into(),
+            ],
+        );
+    }
+}
